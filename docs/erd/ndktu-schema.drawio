        <mxCell id="ovfk__32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=10;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;fontSize=10;fontColor=#C62828;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=1.5;" edge="1" parent="1" source="ovbox__user_answers" target="ovbox__users"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ovnote" value="&lt;b&gt;Qanday oʻqiladi&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bu sahifa — umumiy xarita. Bu yerda faqat &lt;b&gt;modullararo&lt;/b&gt; bogʻlanishlar chizilgan: 33 ta strelka.&lt;br&gt;Modul &lt;i&gt;ichidagi&lt;/i&gt; 37 ta bogʻlanish oʻz sahifasida — ustunlari, tiplari va oʻchirish qoidalari bilan (pastdagi ilovalar).&lt;br&gt;&lt;br&gt;&lt;b&gt;→&lt;/b&gt; strelka koʻp tomondan bir tomonga qaraydi (FK → PK).&lt;br&gt;&lt;b&gt;×N&lt;/b&gt; — ikki jadval orasida N ta turli FK bor.&lt;br&gt;Strelka rangi — &lt;i&gt;qaysi&lt;/i&gt; modulga havola qilinayotganini bildiradi." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#FFFDE7;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="1148" width="660" height="170" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
