# Backend REST API manzili.
# Bo'sh qoldiring: prod'da nginx /api/ ni backend:8000 ga proksi qiladi,
# dev'da esa vite.config.ts dagi proxy localhost:8010 ga yuboradi.
# Ikkala holatda ham ilova nisbiy `/api` dan foydalanadi.
VITE_API_URL=/api

# Face-detection WebSocket (test proctoringi, 2-bosqichda ishlatiladi).
# Bo'sh qoldirilsa — joriy origin: ws(s)://<host>/v1/video/stream
VITE_FACE_DETECTION_SERVICE_URL=
