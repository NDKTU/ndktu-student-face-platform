{
  "annotations": { "list": [{ "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0,211,255,1)", "name": "Annotations & Alerts", "type": "dashboard" }] },
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["frontend", "nginx", "logs"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Frontend — Nginx Logs",
  "uid": "nsumt-frontend-logs",
  "version": 1,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total Requests",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "nsumt-loki" },
      "options": { "colorMode": "background", "graphMode": "area", "orientation": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "targets": [{ "expr": "sum(count_over_time({job=\"frontend_access\"}[$__range]))", "legendFormat": "Total", "refId": "A" }]
    },
    {
      "id": 2, "type": "stat", "title": "4xx/5xx Errors",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "loki", "uid": "nsumt-loki" },
      "options": { "colorMode": "background", "graphMode": "area", "orientation": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "targets": [{ "expr": "sum(count_over_time({job=\"frontend_access\"} | status=~\"4..|5..\" [$__range]))", "legendFormat": "Errors", "refId": "A" }]
    },
    {
      "id": 3, "type": "stat", "title": "Nginx Error Log Lines",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "nsumt-loki" },
      "options": { "colorMode": "background", "graphMode": "area", "orientation": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] } }, "overrides": [] },
      "targets": [{ "expr": "sum(count_over_time({job=\"frontend_error\"}[$__range]))", "legendFormat": "Errors", "refId": "A" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Requests by Status Code",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "nsumt-loki" },
      "options": { "tooltip": { "mode": "multi", "sort": "none" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 15, "drawStyle": "bars", "barAlignment": 0 }, "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "3xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "targets": [
        { "expr": "sum(count_over_time({job=\"frontend_access\"} | status=~\"2..\" [$__interval]))", "legendFormat": "2xx", "refId": "A" },
        { "expr": "sum(count_over_time({job=\"frontend_access\"} | status=~\"3..\" [$__interval]))", "legendFormat": "3xx", "refId": "B" },
        { "expr": "sum(count_over_time({job=\"frontend_access\"} | status=~\"4..\" [$__interval]))", "legendFormat": "4xx", "refId": "C" },
        { "expr": "sum(count_over_time({job=\"frontend_access\"} | status=~\"5..\" [$__interval]))", "legendFormat": "5xx", "refId": "D" }
      ]
    },
    {
      "id": 5, "type": "logs", "title": "Access Logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "nsumt-loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{ "expr": "{job=\"frontend_access\"}", "legendFormat": "", "refId": "A", "maxLines": 500 }]
    },
    {
      "id": 6, "type": "logs", "title": "Error Logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "loki", "uid": "nsumt-loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{ "expr": "{job=\"frontend_error\"}", "legendFormat": "", "refId": "A", "maxLines": 200 }]
    }
  ]
}
