# ═══════════════════════════════════════════════════════════════════
# Root .env template — used by docker-compose for backend,
# face-detection, postgres and redis services.
#
# Setup:
#   1. cp .env.example .env
#   2. Fill in real values for every <CHANGE_ME> placeholder.
#   3. NEVER commit the real .env — it is gitignored.
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ═══════════════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────────────
POSTGRES_USER=<CHANGE_ME_DB_USER>
POSTGRES_PASSWORD=<CHANGE_ME_DB_PASSWORD>
POSTGRES_DB=basic_database

APP_CONFIG__DATABASE__URL=postgresql+asyncpg://<CHANGE_ME_DB_USER>:<CHANGE_ME_DB_PASSWORD>@database:5432/basic_database
APP_CONFIG__DATABASE__TEST_URL=postgresql+asyncpg://<CHANGE_ME_DB_USER>:<CHANGE_ME_DB_PASSWORD>@database:5432/test_db
APP_CONFIG__DATABASE__ECHO=False
APP_CONFIG__DATABASE__ECHO_POOL=False
APP_CONFIG__DATABASE__POOL_SIZE=15
APP_CONFIG__DATABASE__MAX_OVERFLOW=5

# ─── Backend server ────────────────────────────────────────────────
APP_CONFIG__SERVER__APP_PATH=app.main:app
APP_CONFIG__SERVER__HOST=0.0.0.0
APP_CONFIG__SERVER__PORT=8000
# Nechta jarayon. Ajratilgan yadro sonidan oshmasin — yadrolarni backend
# bilan birga face-detection, Postgres va Redis ham bo'lishadi. Imtihon
# paytida backend va face-detection barobar band bo'ladi.
# DIQQAT: POOL_SIZE har bir jarayonga alohida tegishli. Jami ulanish =
# WORKERS x (POOL_SIZE + MAX_OVERFLOW) va u Postgres max_connections
# (100) dan kichik bo'lishi shart.
APP_CONFIG__SERVER__WORKERS=4
# reload prod'da o'chirilsin: u workers'ni jimgina bittaga tushiradi.
APP_CONFIG__SERVER__RELOAD=False
# Set to True in production — disables /docs, /redoc, /openapi.json.
APP_CONFIG__SERVER__IS_PROD=False

# ─── JWT (rotate if leaked) ────────────────────────────────────────
APP_CONFIG__JWT__ACCESS_TOKEN_SECRET=<CHANGE_ME_JWT_ACCESS_SECRET>
APP_CONFIG__JWT__REFRESH_TOKEN_SECRET=<CHANGE_ME_JWT_REFRESH_SECRET>
# Абсолютный потолок жизни токена (мин). Реальный таймаут — скользящий idle ниже.
APP_CONFIG__JWT__ACCESS_TOKEN_EXPIRES_MINUTES=720
APP_CONFIG__JWT__REFRESH_TOKEN_EXPIRES_DAYS=7
# Idle-окно скользящей Redis-сессии (мин). Должно быть >= клиентского idle (15 мин).
APP_CONFIG__JWT__SESSION_IDLE_MINUTES=30
APP_CONFIG__JWT__ALGORITHM=HS256

# ─── File uploads ──────────────────────────────────────────────────
APP_CONFIG__FILE_URL__HTTP=/uploads
APP_CONFIG__FILE_URL__UPLOAD_DIR=uploads

# Yuklangan fayllar host'da qayerda saqlanadi (docker-compose bind mount).
# Prodda repo ichida emas, alohida yo'lda turishi kerak: /srv/nusmt/uploads
UPLOADS_PATH=./backend/uploads

# ─── Hemis external API ────────────────────────────────────────────
APP_CONFIG__HEMIS__LOGIN_URL=https://student.ndki.uz/rest/v1/auth/login
APP_CONFIG__HEMIS__ME_URL=https://student.ndki.uz/rest/v1/account/me

# ─── EduPlan (EPOS) — зеркало оргструктуры ─────────────────────────
# Интеграция строго read-only. Нужен сервисный аккаунт с правами на чтение;
# без него оставьте ENABLED=false, и приложение работает как раньше.
APP_CONFIG__EDUPLAN__ENABLED=false
APP_CONFIG__EDUPLAN__BASE_URL=https://edu.plan.nsumt.uz/rest
# Логин, пароль и X-Active-Role вводятся администратором на экране
# синхронизации и хранятся в таблице eduplan_credentials — строка из БД
# перебивает окружение и сама включает интеграцию (credentials.py).
# Ночная синхронизация ставится системным cron: `make eduplan-cron` печатает
# готовую строку для crontab (обёртка — scripts/eduplan_sync.sh).
# Альтернатива — планировщик ВНУТРИ приложения: добавьте сюда
# APP_CONFIG__EDUPLAN__SCHEDULE_ENABLED=true и APP_CONFIG__EDUPLAN__SCHEDULE_HOUR=<час>
# (час местный, по Ташкенту; по умолчанию 3). Включать что-то одно, не оба.

# ─── Bootstrap admin account ────────────────────────────────────────
# Created once by init_db on first boot if set; no-op if the user already
# exists (safe to leave set permanently — it never overwrites a changed password).
APP_CONFIG__ADMIN__USERNAME=admin
APP_CONFIG__ADMIN__PASSWORD=change-me

# ─── Redis ─────────────────────────────────────────────────────────
APP_CONFIG__REDIS__HOST=redis
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__PREFIX=fastapi-cache

# ─── CORS ──────────────────────────────────────────────────────────
# JSON-форматированный список разрешённых origin'ов. Пустой список = ничего не пускать.
# Пример для прод+дев:
#   APP_CONFIG__CORS__ORIGINS=["https://lms.api.nsumt.uz","http://localhost:3000","http://localhost:5173"]
APP_CONFIG__CORS__ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://lms.api.nsumt.uz","https://lms.api.nsumt.uz"]

# ─── Face detection microservice (shared secret) ───────────────────
# The same value must be set as INTERNAL_SERVICE_TOKEN below.
APP_CONFIG__FACE_SERVICE__URL=http://face-detection:8000
APP_CONFIG__FACE_SERVICE__INTERNAL_TOKEN=<CHANGE_ME_FACE_SERVICE_TOKEN>

# Face detection service config (consumed inside face-detection container)
MODEL_PATH=/face/blaze_face_short_range.tflite
LOG_LEVEL=INFO
INTERNAL_SERVICE_TOKEN=<CHANGE_ME_FACE_SERVICE_TOKEN>

# ─── Yuz tanish dvigateli ───────────────────────────────────────────
# "dlib"  — eski, sinalgan yo'l (~150-250 ms bitta vektor, qulf ostida)
# "onnx"  — MobileFaceNet (~16 ms, parallel; chegara ARCFACE_THRESHOLD)
# Almashtirishdan oldin face-detection/scripts/calibrate_threshold.py ni
# yugurtiring: chegara metrikaga bog'liq va ko'chirib qo'yib bo'lmaydi.
FACE_ENGINE=dlib

# ─── Grafana (log dashboard, localhost:3001) ────────────────────────
GRAFANA_ADMIN_PASSWORD=<CHANGE_ME_GRAFANA_PASSWORD>

# Хостовый порт, на котором публикуется SPA. Внутри контейнера всегда 3000.
# Меняйте, если 3000 на машине уже занят.
FRONTEND_PORT=3000

# ─── Qaysi yadrolarda ishlaydi ──────────────────────────────────────
# Loyihaning barcha konteynerlari shu yadrolarga biriktiriladi. Bitta
# serverda ikkinchi loyiha turgani uchun yarmi unga qoldirilgan.
# Bu yerda kvota (cpus) emas, biriktirish (cpuset) ishlatiladi: kvota
# tugagan oynada barcha oqim muzlaydi va aynan cho'qqida o'tkazuvchanlik
# tushib ketadi. Yadrosi kamroq mashinada qiymatni kichraytiring
# (masalan 0-1), butun mashinani berish uchun 0-7.
CPUSET=0-7

# ─── Zoom Meeting SDK ───────────────────────────────────────────────
# Zoom Marketplace → General App, «Meeting SDK» yoqilgan bo'lsin.
# Ilova sozlamalarida Domain allow list ga sayt domeni qo'shilishi shart,
# aks holda SDK brauzerda ishga tushmaydi.
# Bo'sh qoldirilsa, darsga Zoom havolasi qo'shish o'chiq qoladi.
APP_CONFIG__ZOOM__CLIENT_ID=
APP_CONFIG__ZOOM__CLIENT_SECRET=
